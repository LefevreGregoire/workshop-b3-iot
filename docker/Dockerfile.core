# Dockerfile.core
# Optional standalone image for the MQTT IDS detector.
#
# Nécessite les capabilities NET_ADMIN / NET_RAW au runtime pour piloter
# iptables (voir docker-compose.yml). Image basée sur python:slim pour
# rester légère sur du Raspberry Pi (support multi-arch via buildx, cf. CI).

FROM python:3.11-slim

LABEL org.opencontainers.image.title="ids-core"
LABEL org.opencontainers.image.description="Alert classification + automated first-response for the inter-vessel IDS"

# iptables is only needed when the detector is later paired with isolation mode.
# tini : reap correct des process + gestion propre des signaux (SIGTERM) en PID 1
RUN apt-get update && apt-get install -y --no-install-recommends \
        iptables \
        tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY py/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY py/ ./py/

# Répertoires partagés (montés en volumes dans docker-compose.yml)
RUN mkdir -p /app/logs /app/config

ENV IDS_DEVICES_CONFIG=/app/py/devices.yaml \
    IDS_ALERTS_LOG=/app/logs/alerts.jsonl \
    IDS_ACTIONS_LOG=/app/logs/first_response_actions.jsonl \
    IDS_ISOLATION_STATE=/app/config/isolated_devices.json \
    PYTHONUNBUFFERED=1

# This image is not started by the default compose stack because py/server.py
# already consumes MQTT and runs the IDS. Running both would duplicate alerts.

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python3", "py/ids.py", "--mqtt-broker", "mosquitto", "--server-url", "http://ids-web:5000"]
