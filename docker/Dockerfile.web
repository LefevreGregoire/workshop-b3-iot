# Dockerfile.web
# Image du service "ids-web" : API Flask + dashboard (statique) servis
# ensemble via gunicorn.

FROM python:3.11-slim

LABEL org.opencontainers.image.title="ids-web"
LABEL org.opencontainers.image.description="Dashboard temps réel + API de logs/alertes pour l'IDS inter-vaisseau"

WORKDIR /app

COPY web/backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY web/backend/ ./backend/
COPY web/frontend/ ./frontend/
COPY scripting/devices.yaml ./scripting/devices.yaml

RUN mkdir -p /app/logs /app/config

ENV IDS_DEVICES_CONFIG=/app/scripting/devices.yaml \
    IDS_ALERTS_LOG=/app/logs/alerts.jsonl \
    IDS_HEARTBEATS=/app/logs/heartbeats.jsonl \
    FRONTEND_DIR=/app/frontend \
    PYTHONUNBUFFERED=1

RUN useradd --create-home --uid 1001 webrunner \
    && chown -R webrunner:webrunner /app
USER webrunner

EXPOSE 5000

CMD ["gunicorn", "--chdir", "backend", "--bind", "0.0.0.0:5000", \
     "--workers", "2", "--threads", "4", "--timeout", "60", "app:app"]
