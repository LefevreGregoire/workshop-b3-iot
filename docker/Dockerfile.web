# Dockerfile.web
# Image du service "ids-web" : API Flask + dashboard statique.

FROM python:3.11-slim

LABEL org.opencontainers.image.title="ids-web"
LABEL org.opencontainers.image.description="Dashboard temps réel + API de logs/alertes pour l'IDS inter-vaisseau"

WORKDIR /app

COPY py/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY py/ ./py/
COPY web/ ./web/

RUN mkdir -p /app/logs /app/config

ENV IDS_RESPONSE_MODE=observe \
    IDS_ALERTS_LOG=/app/logs/alerts.jsonl \
    IDS_HEARTBEATS=/app/logs/heartbeats.jsonl \
    PYTHONUNBUFFERED=1

RUN useradd --create-home --uid 1001 webrunner \
    && chown -R webrunner:webrunner /app
USER webrunner

EXPOSE 5000

CMD ["python3", "py/server.py"]
